---
import BaseLayout from "../layouts/BaseLayout.astro";

const channels = [
  {
    label: "Email",
    value: "ryanxgreenup@gmail.com",
    href: "mailto:ryanxgreenup@gmail.com",
    hint: "I reply within a day, i'm pretty good.",
    icon: "mail",
  },
  {
    label: "GitHub",
    value: "github.com/ryangreenup",
    href: "https://github.com/ryangreenup",
    hint: "Code, open-source projects, and the occasional issue thread.",
    icon: "github",
  },
  {
    label: "LinkedIn",
    value: "in/ryan-greenup-866685294",
    href: "https://www.linkedin.com/in/ryan-greenup-866685294",
    hint: "For recruiters and the formalities. Mention the role.",
    icon: "linkedin",
  },
];
---

<BaseLayout title="Contact" description="Get in touch with Ryan Greenup.">
  <header class="page-head">
    <p class="kicker">Contact</p>
    <h1 class="page-head__title">Let's talk.</h1>
    <p class="page-head__lede">
      Open to <strong>staff and senior engineering roles</strong>; remote, or
      hybrid in Melbourne. Also happy to chat about systems architecture,
      mentoring, or a problem you're stuck on. No pitch required.
    </p>
  </header>

  <ul class="channels">
    {
      channels.map((c) => (
        <li>
          <a class="channel" href={c.href} rel="me noopener">
            <span class="channel__icon" aria-hidden="true">
              {c.icon === "mail" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
              {c.icon === "github" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.71-.23.71-.5v-1.8c-2.9.63-3.52-1.4-3.52-1.4-.48-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.36-1.14.66-1.4-2.32-.26-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.1-.27-.46-1.34.1-2.78 0 0 .87-.28 2.86 1.06a9.9 9.9 0 0 1 5.2 0c1.98-1.34 2.85-1.06 2.85-1.06.57 1.44.21 2.51.1 2.78.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.9-4.78 5.15.38.32.71.95.71 1.92v2.85c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z" />
                </svg>
              )}
              {c.icon === "linkedin" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4z" />
                </svg>
              )}
            </span>
            <span class="channel__body">
              <span class="channel__top">
                <span class="channel__label">{c.label}</span>
                <span class="channel__value">{c.value}</span>
              </span>
              <span class="channel__hint">{c.hint}</span>
            </span>
            <span class="channel__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .channels {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    max-width: var(--prose-max);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-5);
    background: var(--surface-raised);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  .channel:hover {
    border-color: var(--accent-border);
    background: var(--surface-hover);
  }
  .channel__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .channel__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    flex: 1;
    min-width: 0;
  }
  .channel__top {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-3);
    flex-wrap: wrap;
  }
  .channel__label {
    font-weight: var(--weight-semibold);
    color: var(--fg-primary);
  }
  .channel__value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-tertiary);
  }
  .channel__hint {
    font-size: var(--text-sm);
    color: var(--fg-secondary);
  }
  .channel__arrow {
    color: var(--fg-muted);
    font-size: var(--text-lg);
    transition:
      transform var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }
  .channel:hover .channel__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
