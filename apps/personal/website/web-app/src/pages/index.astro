---
import { Button } from "@rs/ryan-personal-website-components";

import BaseLayout from "../layouts/BaseLayout.astro";

// Clean starting shell: the layout wires in the design system (tokens, theme,
// fonts) and this page renders a website-components island to demonstrate the
// full source-consumption + hydration path. Replace with real content.
---

<BaseLayout
  title="Ryan Greenup"
  description="Personal website of Ryan Greenup."
>
  <main class="hero">
    <h1>Ryan Greenup</h1>
    <p>Personal website. This is a fresh scaffold wired to the design system.</p>
    <Button client:load variant="primary">Get in touch</Button>
  </main>
</BaseLayout>

<style>
  .hero {
    max-width: 48rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
</style>
