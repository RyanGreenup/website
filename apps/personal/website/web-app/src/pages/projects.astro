---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" description="Selected projects by Ryan Greenup - systems, tooling, and platforms.">
  <header class="page-head">
    <p class="kicker">Projects</p>
    <h1 class="page-head__title">Things I've built and kept building.</h1>
    <p class="page-head__lede">
      A selection of work that's either shipped to production or lives in the
      open. Most of it sits at the boundary between a system and the people who
      have to operate it.
    </p>
  </header>

  <div class="projects-grid">
    {
      projects.map((p) => (
        <ProjectCard
          title={p.title}
          description={p.description}
          tech={p.tech}
          github={p.github}
          live={p.live}
          note={p.note}
          comingSoon={p.comingSoon}
        />
      ))
    }
  </div>
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-5);
  }
  @media (max-width: 760px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
