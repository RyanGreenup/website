---
import { ClientRouter } from "astro:transitions";
import "@rs/ryan-personal-website-design/global.css";
import "@rs/ryan-personal-website-design/theme.css";
import "../styles/ui.css";

import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={wide ? "rail rail--wide" : "rail"}>
      <slot />
    </main>
    <SiteFooter />

    <style is:global>
      html {
        min-height: 100%;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .skip-link {
        position: absolute;
        left: var(--spacing-4);
        top: var(--spacing-2);
        transform: translateY(-150%);
        z-index: 50;
        background: var(--accent);
        color: var(--fg-on-accent);
        padding: var(--spacing-2) var(--spacing-4);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        transition: transform var(--duration-base) var(--ease-standard);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      .rail {
        flex: 1 0 auto;
        width: 100%;
        max-width: var(--content-max);
        margin-inline: auto;
        padding-inline: var(--spacing-6);
        padding-block: var(--spacing-16) var(--spacing-24);
      }
      .rail--wide {
        max-width: 72rem;
      }

      @media (max-width: 640px) {
        .rail {
          padding-inline: var(--spacing-5);
          padding-block: var(--spacing-10) var(--spacing-16);
        }
      }

      a:focus-visible,
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
      }
    </style>
  </body>
</html>
