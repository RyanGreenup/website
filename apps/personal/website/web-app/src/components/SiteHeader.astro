---
import ThemeToggle from "./ThemeToggle.tsx";

const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
function isActive(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href + "/");
}
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Ryan Greenup - home">
      <span class="brand__mark" aria-hidden="true">RG</span>
      <span class="brand__name">Ryan Greenup</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle client:idle />
      <button
        type="button"
        class="nav-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-header-mobile-nav"
        data-nav-open
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav-overlay">
    <button
      type="button"
      class="nav-backdrop"
      data-open="false"
      aria-label="Close navigation"
      aria-hidden="true"
      tabindex="-1"
      data-nav-close
    ></button>

    <nav
      id="site-header-mobile-nav"
      class="nav-sheet"
    data-open="false"
    aria-label="Primary"
    aria-hidden="true"
  >
    <div class="nav-sheet__head">
      <span class="nav-sheet__title">Menu</span>
      <button
        type="button"
        class="nav-sheet__close"
        aria-label="Close navigation"
        tabindex="-1"
        data-nav-close
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    {
      nav.map((item, index) => (
        <a
          href={item.href}
          class="nav-sheet__link"
          tabindex="-1"
          aria-current={isActive(item.href) ? "page" : undefined}
          data-nav-link
        >
          <span class="nav-index">{String(index + 1).padStart(2, "0")}</span>
          <span>{item.label}</span>
        </a>
      ))
    }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border-subtle);
  }
  /*
   * The frosted bar lives on this ::before layer rather than on the header
   * itself: backdrop-filter would make the header the containing block for its
   * position:fixed children, trapping the backdrop/sheet inside the thin header
   * strip. Keeping the filter off the header lets the overlay fill the viewport.
   */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--surface-base) 86%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
  }
  .site-header__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--spacing-3) var(--spacing-6);
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-3);
    flex-shrink: 0;
    white-space: nowrap;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-primary);
  }
  .brand__mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--fg-on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
  }
  .brand__name {
    font-size: var(--text-md);
  }

  .nav {
    margin-inline-start: auto;
  }
  .nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding-inline: var(--spacing-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--fg-secondary);
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  .nav__link:hover {
    color: var(--fg-primary);
    background: var(--surface-hover);
  }
  .nav__link[aria-current="page"] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  /* ---- Mobile opener (hidden on desktop) ------------------------------- */
  .nav-toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: var(--surface-raised);
    color: var(--fg-primary);
    cursor: pointer;
  }

  /* ---- Backdrop + slide-in sheet (shown < 760px) ----------------------- */
  /*
   * A viewport-sized clipping layer. `overflow: hidden` keeps the sheet parked
   * at translateX(100%) from widening the document (no horizontal scrollbar
   * when closed). The layer is click-through; its children re-enable pointer
   * events. Only present below the breakpoint.
   */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    overflow: hidden;
    pointer-events: none;
  }
  .nav-backdrop {
    position: absolute;
    inset: 0;
    border: none;
    cursor: pointer;
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    background: color-mix(in srgb, var(--fg-primary) 45%, transparent);
    backdrop-filter: blur(2px);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      visibility var(--duration-base) var(--ease-standard);
  }
  .nav-backdrop[data-open="true"] {
    opacity: 1;
    visibility: visible;
  }

  .nav-sheet {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(82vw, 20rem);
    display: flex;
    pointer-events: auto;
    flex-direction: column;
    gap: var(--spacing-1);
    padding: var(--spacing-6);
    background: var(--surface-raised);
    border-left: 1px solid var(--border-default);
    box-shadow: -24px 0 60px color-mix(in srgb, var(--fg-primary) 18%, transparent);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform var(--duration-slow) var(--ease-reveal),
      visibility var(--duration-slow) var(--ease-reveal);
  }
  .nav-sheet[data-open="true"] {
    transform: translateX(0);
    visibility: visible;
  }

  .nav-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-2);
  }
  .nav-sheet__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--fg-tertiary);
  }
  .nav-sheet__close {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: var(--surface-raised);
    color: var(--fg-primary);
    cursor: pointer;
    transition:
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  .nav-sheet__close:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    color: var(--fg-tertiary);
  }
  .nav-sheet__link {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-3);
    padding-block: var(--spacing-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--fg-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-sheet__link[aria-current="page"] {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .brand__name {
      display: none;
    }
    .nav {
      display: none;
    }
    .nav-toggle {
      display: inline-grid;
    }
    .nav-overlay {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-backdrop,
    .nav-sheet {
      transition: none;
    }
  }

  :global(.theme-toggle) {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: var(--surface-raised);
    color: var(--fg-secondary);
    cursor: pointer;
    transition:
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  :global(.theme-toggle:hover) {
    color: var(--fg-primary);
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }
</style>

<script>
  // Wire the mobile slide-in sheet: open/close, Escape, and body scroll lock.
  // Everything keys off the `data-open` attribute the CSS animates against.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const opener = header.querySelector<HTMLButtonElement>("[data-nav-open]");
    const sheet = header.querySelector<HTMLElement>("#site-header-mobile-nav");
    const backdrop = header.querySelector<HTMLElement>(".nav-backdrop");
    const closers = header.querySelectorAll<HTMLElement>("[data-nav-close]");
    const links = header.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
    const focusables = header.querySelectorAll<HTMLElement>(
      "[data-nav-close], [data-nav-link]",
    );

    const setOpen = (open: boolean): void => {
      sheet?.setAttribute("data-open", String(open));
      backdrop?.setAttribute("data-open", String(open));
      sheet?.setAttribute("aria-hidden", String(!open));
      backdrop?.setAttribute("aria-hidden", String(!open));
      opener?.setAttribute("aria-expanded", String(open));
      for (const el of focusables) el.tabIndex = open ? 0 : -1;
      if (backdrop) backdrop.tabIndex = open ? 0 : -1;
      document.body.style.overflow = open ? "hidden" : "";
    };

    opener?.addEventListener("click", () => setOpen(true));
    for (const el of closers) el.addEventListener("click", () => setOpen(false));
    for (const link of links) link.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
