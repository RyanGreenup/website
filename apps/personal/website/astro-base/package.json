{
  "name": "@rs/ryan-personal-website-astro-base",
  "version": "0.0.0",
  "description": "Shared Astro base configuration for Ryan's personal website.",
  "homepage": "https://github.com/RyanGreenup/kubernetes-3#readme",
  "bugs": {
    "url": "https://github.com/RyanGreenup/kubernetes-3/issues"
  },
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGreenup/kubernetes-3.git"
  },
  "files": [
    "config.ts",
    "src",
    "public"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./config": "./config.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "pnpm run check-types && pnpm run lint && pnpm run test",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt -c ./.config/oxfmtrc.ts --check .",
    "format:write": "oxfmt -c ./.config/oxfmtrc.ts .",
    "lint": "oxlint --type-aware --fix-suggestions -c ./.config/oxlint.config.ts src",
    "check-types": "astro check",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "^0.2.1",
    "@astrojs/node": "^10.1.1",
    "@astrojs/solid-js": "^6.0.1",
    "@rs/oxlint-config": "workspace:*",
    "astro": "^6.3.7",
    "oxlint-tsgolint": "^0.25.0",
    "solid-js": "^1.9.13",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "7.3.3"
  },
  "peerDependencies": {
    "@astrojs/compiler-rs": "^0.2.1",
    "@astrojs/node": "^10.1.1",
    "@astrojs/solid-js": "^6.0.1",
    "astro": "^6.3.7",
    "solid-js": "^1.9.13",
    "vite": "7.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
