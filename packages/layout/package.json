{
  "name": "@rs/layout",
  "version": "0.0.0",
  "private": false,
  "description": "Theme-agnostic layout primitives and headless patterns (Stack, Cluster, AutoGrid, SplitGrid, DashboardLayout); source-based, no build step",
  "homepage": "https://github.com/RyanGreenup/kubernetes-3#readme",
  "bugs": {
    "url": "https://github.com/RyanGreenup/kubernetes-3/issues"
  },
  "license": "MIT",
  "author": "Ryan Greenup <ryanxgreenup@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanGreenup/kubernetes-3.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@rs/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./recipes": {
      "@rs/source": "./src/primitives/recipes.ts",
      "types": "./src/primitives/recipes.ts",
      "import": "./src/primitives/recipes.ts",
      "default": "./src/primitives/recipes.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "true",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:headed": "vitest run --browser.headless=false"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@rs/typescript-config": "workspace:*",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "4.1.7",
    "oxlint-tsgolint": "^0.25.0",
    "playwright": "^1.60.0",
    "solid-js": "^1.9.13",
    "typescript": "^6.0.3",
    "vite": "7.3.3",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
